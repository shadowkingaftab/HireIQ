{
  "dashboard": {
    "title": "ProofHire",
    "panels": [
      {
        "title": "Request Rate",
        "type": "graph",
        "targets": [{ "expr": "rate(http_requests_total[5m])" }]
      },
      {
        "title": "Error Rate",
        "type": "graph",
        "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[5m])" }]
      },
      {
        "title": "Latency p99",
        "type": "graph",
        "targets": [{ "expr": "histogram_quantile(0.99, http_request_duration_seconds)" }]
      }
    ]
  }
}
